 "captions": [
  {
   "text": "Ein ganzer Tag.",
   "start": 0.15,
   "end": 1.0727774172615185
  },
  {
   "text": "So lange braucht jetzt",
   "start": 1.0727774172615185,
   "end": 2.426184295911746
  },
  {
   "text": "ein Funkspruch zu dieser",
   "start": 2.426184295911746,
   "end": 3.9026281635301756
  },
  {
   "text": "Sonde.",
   "start": 3.9026281635301756,
   "end": 4.271739130434783
  },
  {
   "text": "Voyager 1 ist laut",
   "start": 4.663043478260871,
   "end": 5.899299926308034
  },
  {
   "text": "NASA einen Lichttag von",
   "start": 5.899299926308034,
   "end": 7.478960943257186
  },
  {
   "text": "der Erde entfernt.",
   "start": 7.478960943257186,
   "end": 8.715217391304348
  },
  {
   "text": "Rund 25,9 Milliarden Kilometer.",
   "start": 9.106521739130436,
   "end": 12.51521739130435
  },
  {
   "text": "So weit ist noch",
   "start": 12.906521739130437,
   "end": 13.882715609408411
  },
  {
   "text": "nie etwas gekommen,",
   "start": 13.882715609408411,
   "end": 15.041945830363506
  },
  {
   "text": "das Menschen gebaut haben.",
   "start": 15.041945830363506,
   "end": 16.628260869565217
  },
  {
   "text": "Gestartet ist sie vor",
   "start": 17.019565217391303,
   "end": 18.9281206171108
  },
  {
   "text": "49 Jahren.",
   "start": 18.9281206171108,
   "end": 19.836956521739133
  },
  {
   "text": "Seit 2012 fliegt sie",
   "start": 20.22826086956522,
   "end": 21.807391304347828
  },
  {
   "text": "durch den interstellaren Raum.",
   "start": 21.807391304347828,
   "end": 24.17608695652174
  },
  {
   "text": "Mit 17 Kilometern pro",
   "start": 24.567391304347826,
   "end": 26.368290854572713
  },
  {
   "text": "Sekunde.",
   "start": 26.368290854572713,
   "end": 27.054347826086957
  },
  {
   "text": "Von 11 Messgeräten an",
   "start": 27.445652173913043,
   "end": 28.95748230535895
  },
  {
   "text": "Bord laufen nur noch",
   "start": 28.95748230535895,
   "end": 30.397320525783623
  },
  {
   "text": "2.",
   "start": 30.397320525783623,
   "end": 30.54130434782609
  },
  {
   "text": "Wer ihr heute etwas",
   "start": 30.932608695652174,
   "end": 32.21763285024155
  },
  {
   "text": "funkt,",
   "start": 32.21763285024155,
   "end": 32.623429951690824
  },
  {
   "text": "wartet 2 Tage auf",
   "start": 32.623429951690824,
   "end": 33.77318840579711
  },
  {
   "text": "die Antwort.",
   "start": 33.77318840579711,
   "end": 34.58478260869566
  },
  {
   "text": "An Bord ist eine",
   "start": 34.97608695652174,
   "end": 36.20582047685835
  },
  {
   "text": "goldene Schallplatte,",
   "start": 36.20582047685835,

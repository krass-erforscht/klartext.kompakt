  {
   "text": "Sonde.",
   "start": 3.918462037637898,
   "end": 4.289130434782609
  },
  {
   "text": "Voyager 1 ist laut",
   "start": 4.680434782608696,
   "end": 5.985666912306559
  },
  {
   "text": "NASA einen Lichttag von",
   "start": 5.985666912306559,
   "end": 7.653463522476052
  },
  {
   "text": "der Erde entfernt.",
   "start": 7.653463522476052,
   "end": 8.958695652173915

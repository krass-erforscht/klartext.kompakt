 "captions": [
  {
   "text": "Ein ganzer Tag.",
   "start": 0.15,
   "end": 1.0766709928617781
  },
  {
   "text": "So lange braucht jetzt",
   "start": 1.0766709928617781,
   "end": 2.4357884490590527
  },
  {
   "text": "ein Funkspruch zu dieser",
